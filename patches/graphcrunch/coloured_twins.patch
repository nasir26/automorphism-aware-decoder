+#!/usr/bin/env python3
+"""Brute-force validation of the coloured contraction and of the reported group order.
+
+Same method as test_orbits.py, with a vertex colouring: the true orbits and the
+true group order of the colour-preserving automorphism group are found by
+enumerating every permutation, and compared with structure(..., colour=...).
+
+Run:  python3 tests/test_coloured_orbits.py
+"""
+import math, random, sys
+from collections import defaultdict
+from itertools import combinations, permutations, product
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "src"))
+from orbits_serial import structure, find_binary
+
+
+def brute_force(n, ue, col):
+    es = set(map(frozenset, ue))
+    auts = [p for p in permutations(range(n))
+            if all(col[p[v]] == col[v] for v in range(n))
+            and all(frozenset((p[u], p[v])) in es for u, v in ue)]
+    vo = {frozenset(g[x] for g in auts) for x in range(n)}
+    eo = {frozenset(tuple(sorted((g[u], g[v]))) for g in auts) for u, v in ue}
+    return vo, eo, len(auts)
+
+
+def check(n, ue, col, binary):
+    adj = defaultdict(set)
+    for u, v in ue:
+        adj[u].add(v); adj[v].add(u)
+    for v in range(n):
+        adj[v]
+    vlift, elift, _, st = structure(n, adj, sorted(ue), binary, colour=list(col))
+    want_v, want_e, order = brute_force(n, ue, col)
+    if {frozenset(o) for o in vlift} != want_v:
+        return "vertex orbits differ"
+    if {frozenset(tuple(sorted(e)) for e in g) for g in elift} != want_e:
+        return "edge orbits differ"
+    if abs(st["log10_order"] - math.log10(order)) > 1e-9:
+        return f"group order differs: {st['log10_order']} vs {math.log10(order)}"
+    return None
+
+
+def main():
+    binary = find_binary()
+    rnd = random.Random(1)
+    fails, count = 0, 0
+    cases = []
+    for n in range(2, 5):
+        P = list(combinations(range(n), 2))
+        for mask in range(1 << len(P)):
+            ue = [P[i] for i in range(len(P)) if mask >> i & 1]
+            for col in product(range(2), repeat=n):
+                cases.append((n, ue, col))
+    for _ in range(200):
+        n = rnd.choice([5, 6])
+        ue = [e for e in combinations(range(n), 2) if rnd.random() < 0.5]
+        cases.append((n, ue, [rnd.randrange(2) for _ in range(n)]))
+    # same size, different type, same colour: the case the clique flag exists for
+    cases.append((7, [(0, 6), (1, 6), (2, 6), (3, 4), (3, 5), (4, 5), (3, 6), (4, 6), (5, 6)], [0] * 7))
+    # false twins with different colours must not be merged
+    cases.append((3, [(0, 2), (1, 2)], [0, 1, 0]))
+    for n, ue, col in cases:
+        err = check(n, ue, col, binary)
+        count += 1
+        if err:
+            fails += 1
+            print("FAIL", n, ue, col, err)
+    print(f"{count} coloured graphs checked, {fails} failures")
+    sys.exit(1 if fails else 0)
+
+
+if __name__ == "__main__":
+    main()
